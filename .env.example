CONTEXTMAIL_ENV=development
CONTEXTMAIL_DATABASE_URL=sqlite:///./contextmail.db
CONTEXTMAIL_LLM_PROVIDER=ollama
# qwen3:latest is the locally installed 8.2B model in the reference setup
CONTEXTMAIL_LLM_MODEL=qwen3:latest
CONTEXTMAIL_OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTEXTMAIL_LLM_TIMEOUT_SECONDS=120
CONTEXTMAIL_MAX_ITERATIONS=3

# Research: mock (CI/default) or brave (local LIVE mode)
CONTEXTMAIL_SEARCH_PROVIDER=mock
CONTEXTMAIL_BRAVE_SEARCH_API_KEY=
CONTEXTMAIL_SEARCH_MAX_RESULTS=5

# Email: mock (CI/default) or outlook (local authenticated mode)
CONTEXTMAIL_EMAIL_PROVIDER=mock
CONTEXTMAIL_MICROSOFT_CLIENT_ID=
CONTEXTMAIL_MICROSOFT_TENANT_ID=common
CONTEXTMAIL_MICROSOFT_TOKEN_CACHE_PATH=.contextmail/msal_token_cache.json
CONTEXTMAIL_MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
